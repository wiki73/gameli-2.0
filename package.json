{
  "name": "gameli-2.0",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@supabase/supabase-js": "^2.87.1",
    "@tanstack/react-query": "^5.90.16",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "dayjs": "^1.11.19",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router": "^7.11.0",
    "recharts": "^3.6.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.mjs,.jsx,.ts,.tsx --cache --cache-strategy content --cache-location .eslintcache --max-warnings=0",
    "lint:fix": "eslint . --ext .js,.mjs,.jsx,.ts,.tsx --fix --cache --cache-strategy content --cache-location .eslintcache",
    "prettier": "prettier . \"**/*.{js,mjs,jsx,ts,tsx,json,yml,css,md}\" --check --cache --cache-strategy=content --cache-location=.prettiercache",
    "prettier:fix": "prettier . \"**/*.{js,mjs,jsx,json,yml,css,md}\" --write --cache --cache-strategy=content --cache-location=.prettiercache",
    "format": "npm run lint:fix && npm run prettier:fix",
    "prepare": "husky"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.2",
    "@recharts/devtools": "^0.0.5",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-unicorn": "^59.0.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier --check"
    ],
    "*.{json,css,scss,md}": [
      "prettier --check"
    ]
  }
}
