  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.mjs,.jsx,.ts,.tsx --cache --cache-strategy content --cache-location .eslintcache --max-warnings=0",
    "lint:fix": "eslint . --ext .js,.mjs,.jsx,.ts,.tsx --fix --cache --cache-strategy content --cache-location .eslintcache",
    "prettier": "prettier . \"**/*.{js,mjs,jsx,ts,tsx,json,yml,css,md}\" --check --cache --cache-strategy=content --cache-location=.prettiercache",
    "prettier:fix": "prettier . \"**/*.{js,mjs,jsx,json,yml,css,md,node.json}\" --write --cache --cache-strategy=content --cache-location=.prettiercache",
    "format": "npm run lint:fix && npm run prettier:fix && npm run typecheck",
    "prepare": "husky",
    "typecheck": "tsc --noEmit --skipLibCheck --pretty --project tsconfig.json",
    "test": "vitest",
    "test:changed": "vitest run --changed --passWithNoTests",
    "test:ci": "vitest run --coverage --reporter=verbose",
    "pre-commit": "lint-staged && npm run test:changed"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.2",
    "@hookform/devtools": "^4.4.0",
    "@recharts/devtools": "^0.0.7",
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-unicorn": "^59.0.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "postcss-mixins": "^12.1.2",
    "postcss-nesting": "^13.0.2",
    "postcss-preset-env": "^11.1.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjsx,ts,tsx,json,yml,md,node.json}": [
      "eslint --max-warnings=0 --no-warn-ignored"
    ],
    "*.{js,jsx,mjs,cjsx,ts,tsx,json,yml,css,md,node.json}": [
      "prettier --check"
    ]
  }
}
