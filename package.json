    "@tanstack/react-query": "^5.90.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^13.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "framer-motion": "^12.27.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.71.1",
    "react-router": "^7.12.0",
    "react-use": "^17.6.0",
    "recharts": "^3.6.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "web-vitals": "^2.1.4",
    "zod": "^4.3.5"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.mjs,.jsx,.ts,.tsx --cache --cache-strategy content --cache-location .eslintcache --max-warnings=0",
    "lint:fix": "eslint . --ext .js,.mjs,.jsx,.ts,.tsx --fix --cache --cache-strategy content --cache-location .eslintcache",
    "prettier": "prettier . \"**/*.{js,mjs,jsx,ts,tsx,json,yml,css,md}\" --check --cache --cache-strategy=content --cache-location=.prettiercache",
    "prettier:fix": "prettier . \"**/*.{js,mjs,jsx,json,yml,css,md,node.json}\" --write --cache --cache-strategy=content --cache-location=.prettiercache",
    "lint:css": "stylelint \"**/*.{css,pcss}\"",
    "lint:css:fix": "stylelint \"**/*.{css,pcss}\" --fix",
    "lint:css:ci": "stylelint \"**/*.{css,pcss}\" --max-warnings=0",
    "format": "npm run lint:fix && npm run lint:css:fix && npm run prettier:fix && npm run typecheck",
    "prepare": "husky",
    "typecheck": "tsc --noEmit --skipLibCheck --pretty --project tsconfig.json"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.2",
    "@recharts/devtools": "^0.0.7",
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-unicorn": "^59.0.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "postcss-mixins": "^12.1.2",
    "postcss-nesting": "^13.0.2",
    "postcss-preset-env": "^11.1.1",
    "stylelint": "^16.26.1",
    "stylelint-config-clean-order": "^8.0.0",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-declaration-strict-value": "^1.10.11",
    "stylelint-order": "^7.0.1",
    "stylelint-selector-bem-pattern": "^4.0.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0"
  },
  "lint-staged": {
    "*.{.js,.mjs,.jsx,.ts,.tsx}": [
      "eslint --max-warnings=0",
      "prettier --check"
    ],
    "*.{js,mjs,jsx,json,yml,css,md,node.json}": [
      "prettier . \"**/*.{js,mjs,jsx,json,yml,css,md,node.json}\" --check"
    ],
    "**/*.{css,pcss}": [
      "stylelint --fix"
    ]
  }
}
