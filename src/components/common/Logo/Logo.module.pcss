.logo {
  position: fixed;
  inset: 0;

  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 24px;
  width: 100%;
  padding: 24px;

  opacity: 0;
  transform: scale(0.96);
  animation: logo-appear 0.2s ease-out forwards;
}

@keyframes logo-appear {
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.logoImage {
  max-width: 400px;
  width: 100%;
  aspect-ratio: 1 / 1;
}

.logoText {
  font-size: 24px;
  text-transform: uppercase;
  font-weight: 400;
}
