{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strictBindCallApply": true,
    "strictNullChecks": true,
    "strictBuiltinIteratorReturn": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx"
  },
  "include": ["vite.config.ts"]
}
